      "topic:agent-skills",
      "topic:claude-skills",
      "skill in:name \"SKILL.md\""
    ],
    "max_pages": 2
  },
  "awesome_lists": [
    {
      "repo": "VoltAgent/awesome-agent-skills",
      "path": "README.md"
    },
    {
      "repo": "ComposioHQ/awesome-claude-skills",
      "path": "README.md"
    },
    {
      "repo": "travisvn/awesome-claude-skills",
      "path": "README.md"
    }
  ],
  "known_orgs": {
    "orgs": [
      "anthropics",
      "vercel-labs",
      "openai",
      "supabase",
      "microsoft",
      "obra",
      "kepano",
      "huggingface",
      "cloudflare",
      "getsentry",
      "trailofbits",
      "expo",
      "google-gemini",
      "stripe"
    ],
    "org_query": "skill in:name,description,readme",
    "org_max_results": 50,
