  },
  "limits": {
    "search_min_interval_s": 2.1,
    "search_max_results_per_query": 1000,
    "cache_ttl_hours": {
      "search": 6,
      "raw_list": 12,
      "issues": 24,
      "feed": 6,
      "meta": 6
    },
    "max_tree_fetches": 250,
    "max_skills_per_repo": 10,
    "large_repo_threshold": 50,
    "max_scan": 800,
    "min_core_remaining": 1500,
    "clawhub_min_interval_s": 2.0,
    "clawhub_max_pages": 150
